{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exilebuildcomppanion",
  "main": "apps/edge-worker/src/worker_http_and_ws_router.ts",
  "compatibility_date": "2025-03-10",
  "assets": {
    "directory": "./apps/pwa/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_ROOMS",
        "class_name": "SessionRoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoomDurableObject"]
    }
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "exile-relay.dunhas.com", "custom_domain": true },
    { "pattern": "exile.dunhas.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
