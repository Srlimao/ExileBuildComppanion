{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exile Relay",
  "version": "0.1.0",
  "identifier": "com.dunhas.exilecompanion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Exile Relay Control Center",
        "width": 460,
        "height": 640,
        "minWidth": 420,
        "minHeight": 540,
        "resizable": true,
        "visible": true,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding"
      },
      {
        "label": "overlay",
        "title": "Exile Relay Overlay",
        "url": "index.html?window=overlay",
        "width": 380,
        "height": 520,
        "minWidth": 300,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding"
      },
      {
        "label": "build-finder",
        "title": "Exile Relay — Find Build",
        "url": "index.html?window=build-finder",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
